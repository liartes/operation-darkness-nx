--- a/sdk/thirdparty/glslang/glslang/OSDependent/Unix/ossource.cpp
+++ b/sdk/thirdparty/glslang/glslang/OSDependent/Unix/ossource.cpp
@@ -172,12 +172,21 @@
     pthread_mutex_t gMutex;
 }
 
-void InitGlobalLock()
+// opdarkness (repris de torchlight-nx) : initialisé une seule fois. InitializeProcess() le réinitialisait à chaque
+// appel ; deux appelants (le SDK, la traduction des shaders du jeu) pouvaient l'écraser pendant qu'un autre fil le
+// tenait, et la compilation suivante restait bloquée pour toujours (vu sur Switch).
+static pthread_once_t gMutexOnce = PTHREAD_ONCE_INIT;
+static void InitGlobalLockOnce()
 {
   pthread_mutexattr_t mutexattr;
   pthread_mutexattr_init(&mutexattr);
   pthread_mutexattr_settype(&mutexattr, PTHREAD_MUTEX_RECURSIVE);
   pthread_mutex_init(&gMutex, &mutexattr);
+}
+
+void InitGlobalLock()
+{
+  pthread_once(&gMutexOnce, InitGlobalLockOnce);
 }
 
 void GetGlobalLock()
