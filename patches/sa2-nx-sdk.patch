+    // chain of the old epoch becomes unknown (a root's children are made again). Otherwise no new node.
+    if (c.pending) return 0;
+    c.nodes.clear();
+    c.by_key.clear();
+    c.bytes = 0;
+    ++c.epoch;
+    ++c.restarts;
+    if (!(parent & kRootBit)) return 0;
+  }
+  const uint32_t index = uint32_t(c.nodes.size());
