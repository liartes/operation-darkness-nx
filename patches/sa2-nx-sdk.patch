diff --git a/sdk/include/rex/kernel/xboxkrnl/rtl.h b/sdk/include/rex/kernel/xboxkrnl/rtl.h
index 540f698..975b7df 100644
--- a/sdk/include/rex/kernel/xboxkrnl/rtl.h
+++ b/sdk/include/rex/kernel/xboxkrnl/rtl.h
@@ -21,4 +21,13 @@ void xeRtlInitializeCriticalSection(X_RTL_CRITICAL_SECTION* cs, uint32_t cs_ptr)
 X_STATUS xeRtlInitializeCriticalSectionAndSpinCount(X_RTL_CRITICAL_SECTION* cs, uint32_t cs_ptr,
                                                     uint32_t spin_count);
 
+// Games that hand a lock around with "RtlTryEnterCriticalSection, else Sleep(0), retry" (Operation Darkness's engine):
+// on the console Sleep(0) only yields, and the thread retries at once on its own hardware thread. On a host with fewer
+// cores, a pure yield loop burns a core per waiting thread, and a real sleep makes each hand-off cost the sleep. The
+// last critical section a thread failed to take with RtlTryEnterCriticalSection is remembered (cleared by a successful
+// try); this waits until that section is released (or max_us), so the caller's Sleep(0) returns right when the retry
+// can succeed. Returns false, without waiting, when the thread's last try did not fail.
+#define REX_HAS_WAIT_MISSED_CRITICAL_SECTION 1
+bool WaitMissedCriticalSection(uint32_t max_us);
+
 }  // namespace rex::kernel::xboxkrnl
