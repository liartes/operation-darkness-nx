+// the guest's scalar regions (flush mode off, between a switch off and the next switch on) and those in which a
+// denormal was read or an underflow happened (MXCSR DE / UE, cleared at each switch off): what keeping the flush mode
+// on everywhere would change.
+#if defined(REX_OD_DENORMAUX) && (defined(__x86_64__) || defined(_M_X64))
+#define REX_OD_DENORMAUX_ON 1
+inline std::atomic<uint64_t> g_od_regions_scalaires{0}, g_od_regions_denormaux{0};
+#endif
