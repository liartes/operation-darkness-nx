+    csr &= ~0x3Fu;
+  }
+  inline void OdDebutRegion() noexcept { csr &= ~0x3Fu; }
+#else
+  inline void OdFinRegion() noexcept {}
+  inline void OdDebutRegion() noexcept {}
+#endif
 
