   simde__m128i a_lo = simde_mm_unpacklo_epi16(a, zero);
   simde__m128i a_hi = simde_mm_unpackhi_epi16(a, zero);
@@ -355,6 +380,17 @@ inline simde__m128i simde_mm_sllv_epi16(simde__m128i a, simde__m128i count) {
 
 // Variable 16-bit logical right shift: widen to 32-bit, shift, narrow back
 inline simde__m128i simde_mm_srlv_epi16(simde__m128i a, simde__m128i count) {
+#if defined(__aarch64__) || defined(_M_ARM64)
+  // operation-darkness-nx: one NEON shift (counts 0-16 here; same result as below, 4 million random cases).
+  uint16x8_t x;
+  int16x8_t n;
+  std::memcpy(&x, &a, 16);
+  std::memcpy(&n, &count, 16);
+  const uint16x8_t r = vshlq_u16(x, vnegq_s16(n));
+  simde__m128i out;
+  std::memcpy(&out, &r, 16);
+  return out;
+#endif
   simde__m128i zero = simde_mm_setzero_si128();
   simde__m128i a_lo = simde_mm_unpacklo_epi16(a, zero);
   simde__m128i a_hi = simde_mm_unpackhi_epi16(a, zero);
@@ -367,6 +403,16 @@ inline simde__m128i simde_mm_srlv_epi16(simde__m128i a, simde__m128i count) {
 
 // Variable 16-bit arithmetic right shift: sign-extend to 32-bit, shift, narrow back
 inline simde__m128i simde_mm_srav_epi16(simde__m128i a, simde__m128i count) {
+#if defined(__aarch64__) || defined(_M_ARM64)
+  // operation-darkness-nx: one NEON shift (counts 0-15 here; same result as below, 4 million random cases).
+  int16x8_t x, n;
+  std::memcpy(&x, &a, 16);
+  std::memcpy(&n, &count, 16);
+  const int16x8_t r = vshlq_s16(x, vnegq_s16(n));
+  simde__m128i out;
+  std::memcpy(&out, &r, 16);
+  return out;
+#endif
   simde__m128i zero = simde_mm_setzero_si128();
   // Sign-extend a: duplicate each 16-bit lane, then arithmetic shift right by 16
   simde__m128i a_lo = simde_mm_srai_epi32(simde_mm_unpacklo_epi16(a, a), 16);
