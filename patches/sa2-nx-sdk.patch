+    cache_node_ = 0;  // an error: its state from here is not one the cache knows
+    return false;
+  }
+  ++c.decoded;
+  if (hit && hit->pcm_bytes == pcm_bytes) {
+    // verify mode (or a long run): the decoded samples against the node's
